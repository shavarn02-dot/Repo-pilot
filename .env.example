# Backend (copy values into backend/.env or your shell — never commit real keys)
# OpenRouter: up to 4 keys, comma-separated, tried in order — if key 1 fails
# (401/403/429/provider error) RepoPilot automatically falls back to key 2, then 3, then 4.
OPENROUTER_API_KEYS=key1,key2,key3,key4
# Legacy single-key alternative (OPENROUTER_API_KEYS takes precedence, this is added first if both set):
OPENROUTER_API_KEY=
GITHUB_TOKEN=
DATABASE_URL=sqlite:///./repopilot.db
VISUAL_STORAGE_DIR=./data/visual
# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
